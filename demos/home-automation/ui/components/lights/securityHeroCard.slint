import { AppState } from "../../appState.slint";
import { LightsTheme } from "lightsTheme.slint";
import { GlassPanel } from "glassPanel.slint";
import { ShadowText } from "shadowText.slint";

export component SecurityHeroCard inherits GlassPanel {
    radius: 14px;
    outline: LightsTheme.panel-border;

    ShadowText {
        x: 44px;
        y: 45px;
        width: 390px;
        height: 70px;
        label: "Home Secure";
        size: 51px;
        weight: FontWeight.bold;
    }

    HorizontalLayout {
        x: 44px;
        y: 124px;
        width: 340px;
        height: 45px;
        spacing: 12px;

        Text {
            text: "Alarm";
            font-family: AppState.default-font-family;
            font-size: 36px;
            color: LightsTheme.muted-text;
            vertical-alignment: center;
        }

        Text {
            text: "Armed";
            font-family: AppState.default-font-family;
            font-size: 36px;
            font-weight: FontWeight.bold;
            color: LightsTheme.safe;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 452px;
        y: 38px;
        width: 1px;
        height: 124px;
        background: #65518466;
    }

    Rectangle {
        x: 570px;
        y: 48px;
        width: 122px;
        height: 122px;
        border-radius: self.width / 2;
        background: #8be7c01f;
        border-width: 2px;
        border-color: #8be7c080;
    }

    Image {
        x: 601px;
        y: 76px;
        width: 60px;
        height: 60px;
        source: @image-url("../../images/primer-icons/shield.svg");
        colorize: LightsTheme.safe;
    }

    Rectangle {
        x: 31px;
        y: 195px;
        width: 716px;
        height: 72px;
        border-radius: 14px;
        border-width: 2px;
        border-color: LightsTheme.panel-border-soft;
        background: #151020a8;

        for item[index] in [
            { label: "Doors", value: "Locked" },
            { label: "Windows", value: "Closed" },
            { label: "Motion", value: "Clear" },
        ] : Rectangle {
            x: index * 238px;
            width: 238px;
            height: 100%;

            if index > 0 : Rectangle {
                width: 1px;
                height: 100%;
                background: #6b5b8854;
            }

            Text {
                x: 22px;
                y: 13px;
                width: 190px;
                height: 22px;
                text: item.label;
                font-family: AppState.default-font-family;
                font-size: 18px;
                color: LightsTheme.muted-text;
            }

            Text {
                x: 22px;
                y: 34px;
                width: 190px;
                height: 29px;
                text: item.value;
                font-family: AppState.default-font-family;
                font-size: 25px;
                font-weight: FontWeight.bold;
                color: LightsTheme.white;
            }
        }
    }
}
