import { LightsTheme } from "lightsTheme.slint";
import { GlassPanel } from "glassPanel.slint";
import { ShadowText } from "shadowText.slint";
import { ChevronIcon } from "icons.slint";

export component SecurityDeviceCard inherits GlassPanel {
    in property <string> title;
    in property <string> value;
    in property <image> icon;

    radius: 14px;
    outline: LightsTheme.panel-border-soft;

    Image {
        x: 36px;
        y: 52px;
        width: 58px;
        height: 58px;
        source: root.icon;
        colorize: LightsTheme.muted-text;
    }

    ShadowText {
        x: 108px;
        y: 37px;
        width: parent.width - 168px;
        height: 43px;
        label: root.title;
        size: 31px;
        weight: FontWeight.bold;
    }

    ShadowText {
        x: 108px;
        y: 84px;
        width: parent.width - 170px;
        height: 47px;
        label: root.value;
        size: 40px;
        weight: FontWeight.bold;
        text-color: LightsTheme.muted-text;
    }

    ChevronIcon {
        x: parent.width - 52px;
        y: 71px;
        width: 30px;
        height: 42px;
        icon-color: LightsTheme.muted-text;
    }
}
