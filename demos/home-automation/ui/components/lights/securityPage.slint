import { LightsTheme } from "lightsTheme.slint";
import { SecurityHeroCard } from "securityHeroCard.slint";
import { StatusCard } from "statusCard.slint";

export component SecurityPage inherits Rectangle {
    SecurityHeroCard {
        x: 0px;
        y: 0px;
        width: 780px;
        height: 289px;
    }

    StatusCard {
        x: 0px;
        y: 310px;
        width: 375px;
        height: 181px;
        title: "Front Door";
        value: "Locked";
        caption: "Last opened 8:42";
        icon: @image-url("../../images/primer-icons/lock.svg");
        accent: LightsTheme.safe;
    }

    StatusCard {
        x: 390px;
        y: 310px;
        width: 390px;
        height: 181px;
        title: "Cameras";
        value: "Live";
        caption: "Porch and yard online";
        icon: @image-url("../../images/primer-icons/check-circle.svg");
        accent: LightsTheme.purple;
    }
}
