import { LightsTheme } from "lightsTheme.slint";
import { ClimateHeroCard } from "climateHeroCard.slint";
import { StatusCard } from "statusCard.slint";

export component ClimatePage inherits Rectangle {
    ClimateHeroCard {
        x: 0px;
        y: 0px;
        width: 780px;
        height: 289px;
    }

    StatusCard {
        x: 0px;
        y: 310px;
        width: 375px;
        height: 181px;
        title: "Humidity";
        value: "42%";
        caption: "Comfort range";
        icon: @image-url("../../images/primer-icons/pulse.svg");
        accent: LightsTheme.cool;
    }

    StatusCard {
        x: 390px;
        y: 310px;
        width: 390px;
        height: 181px;
        title: "Energy";
        value: "1.8 kW";
        caption: "HVAC running low";
        icon: @image-url("../../images/primer-icons/zap.svg");
        accent: LightsTheme.warm;
    }
}
