import { AppState } from "../../appState.slint";
import { LightsTheme } from "lightsTheme.slint";
import { GlassPanel } from "glassPanel.slint";
import { ShadowText } from "shadowText.slint";

export component ClimateHeroCard inherits GlassPanel {
    radius: 14px;
    outline: LightsTheme.panel-border;

    ShadowText {
        x: 44px;
        y: 45px;
        width: 390px;
        height: 70px;
        label: "Living Room";
        size: 51px;
        weight: FontWeight.bold;
    }

    HorizontalLayout {
        x: 44px;
        y: 124px;
        width: 360px;
        height: 45px;
        spacing: 12px;

        Text {
            text: "Cooling";
            font-family: AppState.default-font-family;
            font-size: 36px;
            color: LightsTheme.muted-text;
            vertical-alignment: center;
        }

        Text {
            text: "72 F";
            font-family: AppState.default-font-family;
            font-size: 36px;
            font-weight: FontWeight.bold;
            color: LightsTheme.cool;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 452px;
        y: 38px;
        width: 1px;
        height: 124px;
        background: #65518466;
    }

    Rectangle {
        x: 560px;
        y: 36px;
        width: 145px;
        height: 145px;
        border-radius: self.width / 2;
        background: #82d9ff18;
        border-width: 2px;
        border-color: #82d9ff77;
    }

    Rectangle {
        x: 579px;
        y: 55px;
        width: 107px;
        height: 107px;
        border-radius: self.width / 2;
        background: #080810aa;
        border-width: 2px;
        border-color: #ffffff20;
    }

    ShadowText {
        x: 595px;
        y: 78px;
        width: 76px;
        height: 48px;
        label: "72";
        size: 44px;
        weight: FontWeight.bold;
        text-color: LightsTheme.white;
    }

    Text {
        x: 623px;
        y: 124px;
        width: 34px;
        height: 22px;
        text: "F";
        font-family: AppState.default-font-family;
        font-size: 19px;
        font-weight: FontWeight.bold;
        color: LightsTheme.cool;
        horizontal-alignment: center;
    }

    Rectangle {
        x: 31px;
        y: 195px;
        width: 716px;
        height: 72px;
        border-radius: 14px;
        border-width: 2px;
        border-color: LightsTheme.panel-border-soft;
        background: #151020a8;

        Rectangle {
            x: 88px;
            y: 22px;
            width: 536px;
            height: 41px;
            border-radius: 20px;
            background: #ffffff12;
            border-width: 1px;
            border-color: #ffffff22;
            clip: true;

            Rectangle {
                x: 0px;
                y: 0px;
                width: 362px;
                height: 100%;
                border-radius: parent.border-radius;
                background: @linear-gradient(90deg, LightsTheme.cool 0%, #eadbff 100%);
            }

            Rectangle {
                x: 337px;
                y: -3px;
                width: 47px;
                height: 47px;
                border-radius: self.width / 2;
                background: LightsTheme.white;
            }
        }

        Image {
            x: 22px;
            y: 19px;
            width: 28px;
            height: 28px;
            source: @image-url("../../images/primer-icons/flame.svg");
            colorize: LightsTheme.cool;
        }

        Text {
            x: 646px;
            y: 18px;
            width: 54px;
            height: 40px;
            text: "68";
            font-family: AppState.default-font-family;
            font-size: 28px;
            font-weight: FontWeight.bold;
            color: LightsTheme.muted-text;
        }
    }
}
